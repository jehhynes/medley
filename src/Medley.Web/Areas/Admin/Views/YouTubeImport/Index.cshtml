@model YouTubeImportViewModel

@{
    ViewData["Title"] = "Import YouTube Videos";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="card" style="max-width:50rem;">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-youtube me-2 text-danger"></i>
                        Import YouTube Videos
                    </h5>
                </div>
                <div class="card-body">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <div class="mb-4">
                        <p class="text-muted">
                            Paste one or more YouTube URLs below (one per line). Each video's transcript and metadata
                            will be fetched via SocialKit and saved as a source.
                        </p>
                    </div>

                    <form asp-action="Import" method="post" id="importForm">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="mb-4">
                            <label asp-for="UrlsText" class="form-label fw-bold">YouTube URLs</label>
                            <textarea asp-for="UrlsText" class="form-control font-monospace" rows="10"
                                      placeholder="https://www.youtube.com/watch?v=...&#10;https://youtu.be/...&#10;https://www.youtube.com/shorts/..."></textarea>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-danger btn-lg" id="importBtn">
                                <i class="bi bi-cloud-download me-2"></i>
                                Import Videos
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            @if (Model.ImportResult != null)
            {
                <div class="card mt-4" style="max-width:50rem;">
                    <div class="card-header">
                        <h4 class="card-title mb-0">
                            <i class="bi bi-bar-chart me-2"></i>
                            Import Results
                        </h4>
                    </div>
                    <div class="card-body">
                        <div class="row mb-4">
                            <div class="col-md-3">
                                <div class="text-center p-3 bg-body-secondary rounded">
                                    <h3 class="mb-1 text-primary">@Model.ImportResult.TotalSourcesProcessed</h3>
                                    <small class="text-muted">Total Processed</small>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="text-center p-3 bg-body-secondary rounded">
                                    <h3 class="mb-1 text-success">@Model.ImportResult.SourcesImported</h3>
                                    <small class="text-muted">Imported</small>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="text-center p-3 bg-body-secondary rounded">
                                    <h3 class="mb-1 text-warning">@Model.ImportResult.SourcesSkipped</h3>
                                    <small class="text-muted">Skipped</small>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="text-center p-3 bg-body-secondary rounded">
                                    <h3 class="mb-1 text-info">@Model.ImportResult.Duration.TotalSeconds.ToString("F2")s</h3>
                                    <small class="text-muted">Duration</small>
                                </div>
                            </div>
                        </div>

                        @if (Model.ImportResult.Errors.Any())
                        {
                            <div class="alert alert-danger">
                                <h5 class="alert-heading">
                                    <i class="bi bi-exclamation-circle me-2"></i>
                                    Errors (@Model.ImportResult.Errors.Count)
                                </h5>
                                <ul class="mb-0">
                                    @foreach (var error in Model.ImportResult.Errors)
                                    {
                                        <li>@error</li>
                                    }
                                </ul>
                            </div>
                        }

                        @if (Model.ImportResult.Warnings.Any())
                        {
                            <div class="alert alert-warning">
                                <h5 class="alert-heading">
                                    <i class="bi bi-exclamation-triangle me-2"></i>
                                    Warnings (@Model.ImportResult.Warnings.Count)
                                </h5>
                                <ul class="mb-0">
                                    @foreach (var warning in Model.ImportResult.Warnings)
                                    {
                                        <li>@warning</li>
                                    }
                                </ul>
                            </div>
                        }

                        @if (Model.ImportResult.Success && !Model.ImportResult.Errors.Any())
                        {
                            <div class="alert alert-success mb-0">
                                <i class="bi bi-check-circle me-2"></i>
                                All videos were imported successfully!
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        document.getElementById('importForm').addEventListener('submit', function () {
            const btn = document.getElementById('importBtn');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Importing...';
        });
    </script>
}
